#!/usr/bin/env bash
set -euo pipefail

readonly banned='^(mio|nanocodex-oai-api|reqwest|rusqlite|tokio|wasmtime) v'
readonly pure_crates=(rho-ai rho-core rho-codec-jsonl)

for crate in "${pure_crates[@]}"; do
  if cargo tree --locked --edges normal --prefix none -p "$crate" |
    grep -E "$banned"; then
    echo "error: pure crate $crate depends on a shell/runtime crate" >&2
    exit 1
  fi
done

echo "pure dependency check passed"
